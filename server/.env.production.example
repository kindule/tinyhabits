# ============================================
# 微信云托管生产环境配置模板
# 请在云托管控制台「服务设置」→「环境变量」中配置
# ============================================

# 服务配置（云托管会自动设置）
NODE_ENV=production
PORT=80

# ============================================
# 以下变量需要在云托管控制台手动配置
# ============================================

# MySQL 数据库连接
# 使用云托管的云数据库 MySQL，配置如下：
MYSQL_HOST=mysql.tencentcloudapi.com
MYSQL_PORT=3306
MYSQL_DATABASE=tinyhabits
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password

# JWT 密钥（请生成强密码，至少32位）
# 可使用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-jwt-secret-at-least-32-characters

# JWT 过期时间
JWT_EXPIRES_IN=7d

# AI 服务密钥
DEEPSEEK_API_KEY=your-deepseek-api-key
DOUBAO_API_KEY=your-doubao-api-key
AI_TIMEOUT=10000

# CORS 配置（小程序走内网，可按需配置）
# 多个域名用逗号分隔
CORS_ORIGINS=https://servicewechat.com

# 速率限制
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
