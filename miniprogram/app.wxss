/**
 * app.wxss - 全局样式
 * 多邻国式轻量游戏化界面设计
 * 基于 docs/design/UI实现标准.md
 */

page {
  --page-pad: 20rpx;
  --radius-card: 28rpx;
  --radius-btn: 999rpx;
  --radius-bubble: 999rpx;
  --gap-sm: 12rpx;
  --gap-md: 20rpx;
  --gap-lg: 32rpx;
  --card-pad: 22rpx;
  --scene-h: 280rpx;
  --footer-h: 140rpx;

  --font-h1: 44rpx;
  --font-h2: 34rpx;
  --font-body: 28rpx;
  --font-sub: 24rpx;
  --font-cap: 22rpx;

  --shadow-card: 0 12rpx 30rpx rgba(0, 0, 0, 0.06);
  --shadow-btn: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
  --stroke-soft: 1rpx solid rgba(0, 0, 0, 0.06);

  --c-bg: #FAFBFF;
  --c-text: #1F2A37;
  --c-subtext: rgba(31, 42, 55, 0.65);
  --c-line: rgba(31, 42, 55, 0.10);

  --c-gold: #F6C85F;
  --c-cyan: #5EC8D8;
  --c-purple: #8A7DFF;

  --c-ok: #2ECC71;
  --c-warn: #FFB020;
  --c-rift: #2B1B3D;

  background: var(--c-bg);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--c-text);
  font-size: var(--font-body);
  line-height: 1.4;
}

/* PageShell */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--c-bg);
}

.pageBright {
  background: #FFFFFF;
}

.sceneHeader {
  height: var(--scene-h);
  position: relative;
  overflow: hidden;
}

.sceneHeader--onboarding {
  background: linear-gradient(180deg, rgba(94, 200, 216, 0.26), rgba(250, 251, 255, 1));
  animation: bgFlow 4s ease-in-out infinite;
}

.sceneHeader--workshop {
  background: linear-gradient(180deg, rgba(138, 125, 255, 0.22), rgba(250, 251, 255, 1));
}

.sceneHeader--daily {
  background: linear-gradient(180deg, rgba(246, 200, 95, 0.28), rgba(250, 251, 255, 1));
}

.sceneHeader--wishes {
  background: linear-gradient(180deg, rgba(94, 200, 216, 0.18), rgba(250, 251, 255, 1));
}

.sceneHeader--role {
  background: linear-gradient(180deg, rgba(138, 125, 255, 0.18), rgba(250, 251, 255, 1));
}

.sceneHeader--rift::after {
  content: '';
  position: absolute;
  top: 20rpx;
  right: 30rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, var(--c-rift) 0%, transparent 60%);
  opacity: 0.3;
  border-radius: 50%;
  animation: riftPulse 3s ease-in-out infinite;
}

.dialogueWrap {
  padding: 0 var(--page-pad);
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
}

.content {
  flex: 1;
  padding: var(--gap-md) var(--page-pad);
  overflow-y: auto;
}

.footer {
  padding: var(--gap-md) var(--page-pad);
  padding-bottom: calc(var(--gap-md) + env(safe-area-inset-bottom));
  background: var(--c-bg);
}

/* DialogueBubble */
.dialogue {
  display: flex;
  align-items: flex-start;
  gap: var(--gap-md);
  animation: dialogueIn 200ms ease-out;
}

.dialogueAvatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.dialogueAvatar--arc {
  background: linear-gradient(135deg, var(--c-gold), #FFD700);
  animation: glowPulse 3.5s ease-in-out infinite;
}

.dialogueAvatar--mia {
  background: linear-gradient(135deg, var(--c-cyan), #4DD0E1);
}

.dialogueAvatar--rift {
  background: linear-gradient(135deg, var(--c-rift), #4A148C);
  animation: riftShake 0.5s ease-in-out;
}

.avatarEyes {
  width: 36rpx;
  display: flex;
  justify-content: space-between;
}

.avatarEye {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
}

.avatarEye--rift {
  background: rgba(138, 125, 255, 0.9);
}

.dialogueBubble {
  flex: 1;
  background: rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  padding: 16rpx 18rpx;
  border: var(--stroke-soft);
  box-shadow: var(--shadow-card);
}

.dialogueName {
  font-size: var(--font-cap);
  color: var(--c-subtext);
  margin-bottom: 8rpx;
}

.dialogueText {
  font-size: var(--font-body);
  color: var(--c-text);
  line-height: 1.5;
}

/* MainCard */
.card {
  background: #fff;
  border-radius: var(--radius-card);
  padding: var(--card-pad);
  box-shadow: var(--shadow-card);
  border: var(--stroke-soft);
  transition: transform 120ms ease-out;
}

.cardTitle {
  font-size: var(--font-h2);
  font-weight: 600;
  margin-bottom: var(--gap-sm);
}

.cardDesc {
  font-size: var(--font-sub);
  color: var(--c-subtext);
}

.cardSelected {
  border: 2rpx solid var(--c-gold);
  box-shadow: 0 0 20rpx rgba(246, 200, 95, 0.3);
}

/* Buttons */
.btnPrimary {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-btn);
  background: linear-gradient(90deg, rgba(246, 200, 95, 1), rgba(94, 200, 216, 1));
  color: var(--c-text);
  font-size: var(--font-body);
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 100ms ease-out, box-shadow 100ms ease-out;
  position: relative;
  overflow: hidden;
}

.btnPrimary:active {
  transform: scale(0.96);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btnPrimary::after {
  border: none;
}

.btnPrimary.is-shimmer::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: shimmer 200ms ease-out;
}

.btnSecondary {
  height: 84rpx;
  border-radius: var(--radius-btn);
  background: #fff;
  color: var(--c-text);
  font-size: var(--font-body);
  border: var(--stroke-soft);
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 120ms ease-out;
}

.btnSecondary:active {
  transform: scale(0.98);
}

.btnSecondary::after {
  border: none;
}

/* BubbleChip */
.bubble {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-bubble);
  background: rgba(94, 200, 216, 0.18);
  font-size: var(--font-body);
  margin: var(--gap-sm);
  position: relative;
  transition: transform 160ms ease-out;
}

.bubble::after {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  width: 60%;
  height: 40%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.4), transparent);
  border-radius: var(--radius-bubble);
  pointer-events: none;
}

.bubbleSelected {
  background: rgba(246, 200, 95, 0.3);
  border: 2rpx solid var(--c-gold);
}

.bubblePurple {
  background: rgba(138, 125, 255, 0.18);
}

/* TagPill */
.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(31, 42, 55, 0.06);
  font-size: var(--font-cap);
  color: var(--c-subtext);
}

.tagPurple {
  background: rgba(138, 125, 255, 0.12);
  color: var(--c-purple);
}

.tagGold {
  background: rgba(246, 200, 95, 0.2);
  color: #B8860B;
}

/* Text */
.titleH1 {
  font-size: var(--font-h1);
  font-weight: 700;
  line-height: 1.2;
  color: var(--c-text);
}

.titleH2 {
  font-size: var(--font-h2);
  font-weight: 600;
  line-height: 1.2;
  color: var(--c-text);
}

.textSub {
  font-size: var(--font-sub);
  color: var(--c-subtext);
}

.textCenter {
  text-align: center;
}

/* Layout helpers */
.grid2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--gap-md);
}

.flexCenter {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flexBetween {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flexCol {
  display: flex;
  flex-direction: column;
}

.gapSm {
  gap: var(--gap-sm);
}

.gapMd {
  gap: var(--gap-md);
}

.gapLg {
  gap: var(--gap-lg);
}

.mbSm {
  margin-bottom: var(--gap-sm);
}

.mbMd {
  margin-bottom: var(--gap-md);
}

.mbLg {
  margin-bottom: var(--gap-lg);
}

/* Press feedback for views */
.pressable {
  transition: transform 120ms ease-out, filter 120ms ease-out;
}

.is-pressed {
  transform: scale(0.98);
  filter: brightness(0.98);
}

/* Wishes */
.wishCard {
  background: #fff;
  border-radius: var(--radius-card);
  padding: var(--card-pad);
  box-shadow: var(--shadow-card);
  text-align: center;
  transition: transform 180ms ease-out, box-shadow 180ms ease-out;
  border: 2rpx solid transparent;
}

.wishCardSelected {
  border: 3rpx solid var(--c-gold);
  box-shadow: 0 0 30rpx rgba(246, 200, 95, 0.4);
  animation: cardBounce 180ms ease-out;
}

.wishIcon {
  font-size: 80rpx;
  margin-bottom: var(--gap-sm);
}

.wishName {
  font-size: var(--font-h2);
  font-weight: 600;
  margin-bottom: var(--gap-sm);
}

.wishDesc {
  font-size: var(--font-sub);
  color: var(--c-subtext);
}

.destinyRing {
  width: 100%;
  aspect-ratio: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.destinyRingOuter {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx dashed var(--c-line);
}

.destinyRingMiddle {
  position: absolute;
  width: 70%;
  height: 70%;
  border-radius: 50%;
  border: 2rpx dashed var(--c-cyan);
  opacity: 0.5;
}

.destinyRingCore {
  position: absolute;
  width: 40%;
  height: 40%;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(246, 200, 95, 0.2), rgba(94, 200, 216, 0.2));
  border: 2rpx solid var(--c-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 10rpx;
}

/* Talents */
.talentCard {
  background: #fff;
  border-radius: var(--radius-card);
  padding: var(--card-pad);
  box-shadow: var(--shadow-card);
  text-align: center;
  transition: transform 120ms ease-out, border-color 120ms ease-out;
  border: 2rpx solid transparent;
}

.talentCardSelected {
  border-color: var(--c-gold);
  box-shadow: 0 0 20rpx rgba(246, 200, 95, 0.3);
}

.talentIcon {
  font-size: 60rpx;
  margin-bottom: var(--gap-sm);
}

.talentName {
  font-size: var(--font-h2);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.talentDesc {
  font-size: var(--font-cap);
  color: var(--c-subtext);
  margin-bottom: 8rpx;
}

.talentBonus {
  font-size: var(--font-cap);
  color: var(--c-purple);
}

/* Workshop */
.crystal {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--c-cyan), var(--c-purple));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 0 40rpx rgba(138, 125, 255, 0.4);
  animation: glowPulse 3s ease-in-out infinite;
}

.materialArea {
  min-height: 200rpx;
  background: rgba(138, 125, 255, 0.08);
  border-radius: var(--radius-card);
  padding: var(--gap-md);
  border: 2rpx dashed var(--c-line);
}

.materialTitle {
  font-size: var(--font-sub);
  color: var(--c-subtext);
  margin-bottom: var(--gap-sm);
}

.materialItems {
  display: flex;
  flex-wrap: wrap;
}

/* Daily */
.spellCard {
  background: linear-gradient(135deg, #fff, rgba(246, 200, 95, 0.1));
  border-radius: var(--radius-card);
  padding: 40rpx var(--card-pad);
  box-shadow: var(--shadow-card);
  border: 2rpx solid rgba(246, 200, 95, 0.3);
  text-align: center;
}

.spellIcon {
  font-size: 80rpx;
  margin-bottom: var(--gap-md);
}

.spellName {
  font-size: var(--font-h1);
  font-weight: 700;
  margin-bottom: var(--gap-sm);
}

.spellDesc {
  font-size: var(--font-sub);
  color: var(--c-subtext);
  margin-bottom: var(--gap-md);
}

.spellTags {
  display: flex;
  justify-content: center;
  gap: var(--gap-sm);
}

.riftCard {
  background: linear-gradient(135deg, var(--c-rift), #4A148C);
  color: #fff;
  border-radius: var(--radius-card);
  padding: var(--card-pad);
  text-align: center;
}

.riftCardText {
  font-size: var(--font-body);
  font-style: italic;
  opacity: 0.9;
}

/* Overlay */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.overlayContent {
  width: 80%;
  max-width: 600rpx;
  animation: dialogueIn 200ms ease-out;
}

/* Animations */
@keyframes dialogueIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes glowPulse {
  0%, 100% {
    box-shadow: 0 0 20rpx rgba(246, 200, 95, 0.4);
  }
  50% {
    box-shadow: 0 0 40rpx rgba(246, 200, 95, 0.6);
  }
}

@keyframes riftPulse {
  0%, 100% {
    opacity: 0.3;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(1.1);
  }
}

@keyframes riftShake {
  0%, 100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-4rpx);
  }
  40% {
    transform: translateX(4rpx);
  }
  60% {
    transform: translateX(-4rpx);
  }
  80% {
    transform: translateX(4rpx);
  }
}

@keyframes shimmer {
  from {
    left: -100%;
  }
  to {
    left: 100%;
  }
}

@keyframes bubblePop {
  0% {
    transform: scale(0.8);
    opacity: 0;
  }
  60% {
    transform: scale(1.05);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes cardBounce {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.03);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes riftExplode {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(0);
    opacity: 0;
  }
}

@keyframes sparkleFlash {
  0%, 100% {
    opacity: 0;
    transform: scale(0);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes bgFlow {
  0%, 100% {
    filter: brightness(1);
  }
  50% {
    filter: brightness(1.03);
  }
}

@keyframes riftIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animBubblePop {
  animation: bubblePop 160ms ease-out;
}

.animCardBounce {
  animation: cardBounce 180ms ease-out;
}

.animRiftExplode {
  animation: riftExplode 220ms ease-out forwards;
}

.animRiftIn {
  animation: riftIn 200ms ease-out;
}

.animSparkle {
  animation: sparkleFlash 200ms ease-out;
}
